{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atelier-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "containers": [
    {
      "class_name": "AtelierApi",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ATELIER_API",
        "class_name": "AtelierApi"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AtelierApi"]
    }
  ]
}
